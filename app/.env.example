# Copy to .env and fill in values before deploying.
# Node does not load .env automatically — set env vars in your shell, docker-compose,
# or a process manager. Example: export SESSION_SECRET=... && npm start

# Required in production (NODE_ENV=production). Must be 32+ characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-strong-random-secret-at-least-32-characters

# Set to "production" for production deployments.
NODE_ENV=development

# Port (optional, defaults to 3000).
# PORT=3000

# ---- Database provider ----
# Production uses MySQL. Set MYSQL_URL (preferred) OR the individual MYSQL* vars.
# On Railway, reference the managed MySQL service's variables. No volume required.
# MYSQL_URL=mysql://user:password@host:3306/dbname
#
# Fallback if MYSQL_URL is unset (presence of MYSQLHOST also selects MySQL):
# MYSQLHOST=
# MYSQLPORT=3306
# MYSQLUSER=
# MYSQLPASSWORD=
# MYSQLDATABASE=
#
# Local development only (SQLite backend, used when no MySQL vars are set).
# Retired from the production path — production uses MySQL, not a Railway volume.
# DB_PATH=/absolute/path/to/data.db

# First production boot only. Remove BOOTSTRAP_ADMIN_PASSWORD after admin is created.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
